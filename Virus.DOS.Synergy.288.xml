        <COMMENT ADDRESS="1000:0130" TYPE="end-of-line">=B7D0 (MDA) or BFCA (CGA), + 100h bytes later added</COMMENT>
        <COMMENT ADDRESS="1000:0134" TYPE="end-of-line">Starts copying a few bytes before the virus start</COMMENT>
        <COMMENT ADDRESS="1000:0138" TYPE="end-of-line">(see above)</COMMENT>
